# npm run setup으로 실제 .env와 키를 생성하세요.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
COMPLAINT_CATEGORY_ID=
LOG_CHANNEL_ID=
ALERT_CHANNEL_ID=
ADMIN_ROLE_ID=
SUPER_ADMIN_ID=
SESSION_ENCRYPTION_KEY=
PUBLIC_KEY_PATH=./keys/public.pem
REDIS_URL=
SESSION_TIMEOUT_HOURS=24
COOLDOWN_MINUTES=30
RECORD_RETENTION_DAYS=14
WORK_HOURS_START=9
WORK_HOURS_END=18
WORK_HOURS_TIMEZONE=Asia/Seoul
ACCEPT_COMPLAINTS_OUTSIDE_WORK_HOURS=true
ENABLE_WORK_HOURS_NOTICE=true
MAX_ATTACHMENT_SIZE_MB=10
# 평문 기록에는 본문에 직접 입력한 개인정보가 남을 수 있습니다.
ENABLE_PLAINTEXT_ARCHIVE=false
